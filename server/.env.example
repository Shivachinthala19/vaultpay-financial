# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# You can provide a real MongoDB Atlas/local connection string, or leave blank to use in-memory database
MONGO_URI=mongodb://localhost:27017/nexus_corporate

# JWT Authentication
JWT_SECRET=nexus_corporate_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=1d

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Client Application URL
CLIENT_URL=http://localhost:5173

# Email / SMTP Configuration (Nodemailer)
# (If left empty, system automatically uses ethereal / mock test transporter)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=billing@nexuscorporate.com

# Nexus Branding
NEXUS_CORPORATE_LOGO_URL=https://nexuscorporate.internal/logo.png

# Optional Cloud Storage (AWS S3 / Cloudinary)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=nexus-receipts
